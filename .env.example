# Copy to .env.local and fill in your own values. Do not commit .env.local.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE?schema=pintree"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
ADMIN_EMAIL=""
# 推荐：配置 bcrypt 哈希（运行 pnpm generate-hash <密码> 生成），避免在环境变量中存储明文密码
ADMIN_PASSWORD_HASH=""
# 兼容旧配置（明文，不推荐；若设置了 ADMIN_PASSWORD_HASH 则此项被忽略）
ADMIN_PASSWORD=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 访问日志保留天数（默认 180），过期日志会被自动清理
ANALYTICS_RETENTION_DAYS="180"
